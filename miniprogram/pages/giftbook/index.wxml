<view class="book-page">
  <view class="chrome {{scrolled ? 'scrolled' : ''}}" style="padding-top:{{statusTop}}px">
    <view class="book-header"><button class="account-avatar" bindtap="account" aria-label="账号与设置"><image wx:if="{{avatarKey}}" src="{{avatarKey}}" mode="aspectFill"/><text wx:else>{{avatarText}}</text></button><text class="book-title">礼物簿</text><view class="header-space"></view></view>
    <view wx:if="{{recipients.length}}" class="recipient-switcher">
      <scroll-view class="recipient-scroll" scroll-x="{{!sortingId}}" scroll-left="{{railLeft}}" scroll-into-view="{{sortingId ? '' : activeTabId}}" scroll-with-animation="{{!sortingId}}" enable-flex="true" bindscroll="railScroll"><view class="recipient-tabs"><button wx:for="{{recipients}}" wx:key="id" id="recipient-{{item.id}}" class="recipient-tab {{active.id === item.id ? 'active' : ''}} {{sortingId === item.id ? 'sorting' : ''}} {{targetId === item.id &amp;&amp; sortingId !== item.id ? 'target' : ''}}" data-id="{{item.id}}" bindtap="select" bindlongpress="longPress" bindtouchmove="dragMove" bindtouchend="dragEnd">{{item.display_name}}</button></view></scroll-view>
      <button class="recipient-add" bindtap="create" aria-label="添加 TA">＋</button>
    </view>
  </view>
  <view wx:if="{{error}}" class="book-error" role="alert">{{error}}<button bindtap="load">重试</button></view>
  <view wx:if="{{loading}}" class="book-empty">正在打开礼物簿…</view>
  <block wx:elif="{{!error}}">
    <view wx:if="{{!recipients.length}}" class="book-empty"><view class="empty-title">还没有人</view><button class="empty-action" bindtap="create">添加第一个人</button></view>
    <block wx:else>
      <view class="content">
        <view class="recipient-summary"><view><view class="summary-name">{{active.display_name}}</view><view class="summary-meta">{{active.relation_type}}{{active.age_range ? ' · ' + active.age_range + ' 岁' : ''}}</view></view><button class="circle-action" bindtap="personActions" aria-label="管理这位 TA">•••</button></view>
        <view class="ta-actions"><view class="ta-switch"><button class="{{viewMode === 'records' ? 'selected' : ''}}" bindtap="showRecords">记录</button><button class="{{viewMode === 'saved' ? 'selected' : ''}}" bindtap="showSaved">想送</button></view><button class="find-link" bindtap="findGift">找礼物 ›</button></view>
        <view wx:if="{{active.tags.length}}" class="tag-line"><text wx:for="{{active.tags}}" wx:key="*this">{{index ? ' · ' : ''}}{{item}}</text></view>
        <view wx:if="{{sortingId}}" class="sort-hint">拖到另一位 TA 的位置调整顺序</view>
        <view wx:if="{{viewMode === 'saved'}}" class="saved-list"><view wx:if="{{savedLoading}}" class="log-empty">正在读取想送…</view><view wx:if="{{savedError}}" class="book-error">{{savedError}}<button bindtap="loadSaved">重试</button></view><view wx:if="{{!savedLoading &amp;&amp; !savedGifts.length &amp;&amp; !savedError}}" class="log-empty">还没有想送的礼物<button bindtap="findGift">找一些礼物</button></view><view wx:for="{{savedGifts}}" wx:key="id" class="saved-card"><view class="saved-row"><view class="saved-title">{{item.gift_name}}</view><button data-id="{{item.id}}" bindtap="savedActions" aria-label="更多操作">•••</button></view><view class="saved-meta">{{item.source_snapshot.source_type === 'internal_mock' ? '演示案例' : '来自真实案例'}} · {{item.intended_occasion}} · {{item.intended_price_range}} 元</view><view class="saved-result">{{item.reaction_label}} · {{item.evidence_label}}</view><button class="saved-convert" data-id="{{item.id}}" bindtap="convertSaved">已经送了</button></view></view>
        <view wx:else class="gift-log">
          <view wx:if="{{loadingLog &amp;&amp; !gifts.length}}" class="log-empty">正在读取记录…</view>
          <view wx:if="{{logError}}" class="book-error">{{logError}}<button bindtap="load">重试</button></view>
          <view wx:if="{{!loadingLog &amp;&amp; !gifts.length &amp;&amp; !logError}}" class="log-empty"><view>还没有礼物记录</view><button bindtap="add">记第一份</button></view>
          <view wx:for="{{gifts}}" wx:key="id" class="log-shell" data-id="{{item.id}}" bindtouchstart="swipeStart" bindtouchmove="swipeMove" bindtouchend="swipeEnd"><view class="swipe-actions"><button data-id="{{item.id}}" bindtap="editGift">编辑</button><button class="danger-action" data-id="{{item.id}}" bindtap="deleteGift">删除</button></view><view class="log-entry {{swipeId === item.id ? 'swiped' : ''}}" data-id="{{item.id}}" bindtap="openGift" bindlongpress="giftActions"><view class="log-date"><text class="day">{{item.log_date}}</text><text wx:if="{{item.log_year}}" class="year">{{item.log_year}}</text></view><view class="log-title">{{item.gift_name}}</view><view wx:if="{{item.log_meta}}" class="log-meta">{{item.log_meta}}</view><view class="log-reaction">{{item.log_reaction}}</view><view wx:if="{{item.note}}" class="log-note">{{item.note}}</view></view></view>
          <button wx:if="{{cursor}}" class="load-more" bindtap="more" disabled="{{loadingLog}}">更早的记录</button>
        </view>
      </view>
      <button wx:if="{{viewMode === 'records'}}" class="gift-fab" bindtap="add" aria-label="记一份礼物">＋</button>
    </block>
  </block>
  <view wx:if="{{sheet === 'person'}}" class="sheet-layer"><view class="sheet-backdrop" bindtap="closeSheet"></view><view class="sheet {{sheetFull ? 'full' : ''}}" style="padding-top:{{sheetFull ? statusTop : 0}}px"><button class="sheet-handle" bindtap="expandSheet" aria-label="展开或收起表单"><view></view></button><view class="sheet-heading"><view class="sheet-title">{{sheetEditId ? '编辑 TA' : '添加一个人'}}</view><button class="sheet-close" bindtap="closeSheet" aria-label="关闭">×</button></view><scroll-view scroll-y class="sheet-fields">
    <view class="sheet-field"><text class="field-label">称呼</text><input placeholder="你怎么称呼 TA？" value="{{personForm.display_name}}" data-form="personForm" data-field="display_name" bindinput="sheetInput" maxlength="20"/></view>
    <picker class="sheet-row" range="{{relations}}" data-form="personForm" data-field="relation_type" data-options="relations" bindchange="sheetPick"><text>关系</text><text>{{personForm.relation_type || '请选择'}} ›</text></picker>
    <button class="sheet-row expand-row" bindtap="expandFields"><text>再多记一点</text><text>{{sheetExpanded ? '收起' : '›'}}</text></button>
    <view wx:if="{{sheetExpanded}}"><picker class="sheet-row" range="{{ages}}" data-form="personForm" data-field="age_range" data-options="ages" bindchange="sheetPick"><text>年龄段</text><text>{{personForm.age_range || '选填'}} ›</text></picker><picker class="sheet-row" range="{{genders}}" data-form="personForm" data-field="gender" data-options="genders" bindchange="sheetPick"><text>性别</text><text>{{personForm.gender || '选填'}} ›</text></picker><view class="sheet-field"><text class="field-label">TA 的喜好 · 最多 8 个</text><view class="tag-options"><button wx:for="{{tagChoices}}" wx:key="label" class="tag-choice {{item.selected ? 'selected' : ''}}" data-tag="{{item.label}}" bindtap="sheetTag">{{item.label}}</button></view></view><view class="sheet-field"><text class="field-label">备注</text><textarea placeholder="关于 TA，想记住的事" value="{{personForm.note}}" data-form="personForm" data-field="note" bindinput="sheetInput" maxlength="200"/></view></view>
    <view wx:if="{{sheetError}}" class="sheet-error" role="alert">{{sheetError}}</view>
  </scroll-view><button class="sheet-save" bindtap="saveSheet" loading="{{sheetBusy}}" disabled="{{sheetBusy}}">{{sheetEditId ? '保存修改' : '加入礼物簿'}}</button></view></view>
  <view wx:if="{{sheet === 'find'}}" class="sheet-layer"><view class="sheet-backdrop" bindtap="closeSheet"></view><view class="sheet"><view class="sheet-heading"><view class="sheet-title">给 {{active.display_name}} 找礼物</view><button class="sheet-close" bindtap="closeSheet" aria-label="关闭">×</button></view><view class="sheet-fields"><picker class="sheet-row" range="{{findOccasions}}" data-field="findOccasion" bindchange="findPick"><text>场景 *</text><text>{{findOccasion || '请选择'}} ›</text></picker><picker class="sheet-row" range="{{findPrices}}" data-field="findPrice" bindchange="findPick"><text>预算 *</text><text>{{findPrice ? findPrice + ' 元' : '请选择'}} ›</text></picker><view class="find-context">自动使用：{{active.relation_type}}{{active.age_range ? ' · ' + active.age_range + ' 岁' : ''}}</view><view wx:if="{{sheetError}}" class="sheet-error">{{sheetError}}</view></view><button class="sheet-save" bindtap="findMatches">看看案例</button></view></view>
  <view wx:if="{{sheet === 'matches'}}" class="sheet-layer"><view class="sheet-backdrop" bindtap="closeSheet"></view><view class="sheet full" style="padding-top:{{statusTop}}px"><view class="sheet-heading"><view class="sheet-title">给 {{active.display_name}} 找礼物</view><button class="sheet-close" bindtap="closeSheet" aria-label="关闭">×</button></view><scroll-view scroll-y class="sheet-fields match-scroll"><button class="find-back" bindtap="backFind">‹ 调整场景与预算</button><view wx:if="{{matchLoading}}" class="find-context">正在查找案例…</view><view wx:if="{{matchError}}" class="sheet-error">{{matchError}}<button bindtap="findMatches">重试</button></view><view wx:if="{{!matchLoading &amp;&amp; !matches.length &amp;&amp; !matchError}}" class="find-context">暂时没有符合场景的案例，试试其他场景。</view><view wx:for="{{matches}}" wx:key="id" class="match-card"><button class="match-open" data-id="{{item.case.id}}" bindtap="openMatch"><view class="saved-title">{{item.case.gift_name}}</view><view class="saved-meta">{{item.case.source_type === 'internal_mock' ? '演示案例 · ' : ''}}{{item.case.relation_type}} · {{item.case.age_range}} 岁 · {{item.case.occasion}}</view><view class="saved-meta">{{item.case.price_range}} 元 · {{item.case.wanted_level}}</view><view class="saved-result">{{item.reaction_label}} · {{item.evidence_label}}</view><view class="match-reasons">为什么匹配：{{item.reason_text}}</view></button><button class="saved-convert" data-id="{{item.case.id}}" data-saved="{{item.saved}}" bindtap="saveMatch" disabled="{{item.saved}}">{{item.saved ? '已收藏' : '收藏给 TA'}}</button></view></scroll-view></view></view>
  <gift-sheet id="gift-sheet" bindsaved="giftSheetSaved"/><case-share-sheet id="case-share-sheet" bindsaved="caseShareSaved"/>
</view>

<view class="book-page">
  <view class="chrome {{scrolled ? 'scrolled' : ''}}" style="padding-top:{{statusTop}}px">
    <view class="book-header"><button class="account-avatar" bindtap="account" aria-label="账号与设置"><image wx:if="{{avatarKey}}" src="{{avatarKey}}" mode="aspectFill"/><text wx:else>{{avatarText}}</text></button><text class="book-title">礼物簿</text><view class="header-space"></view></view>
    <view wx:if="{{recipients.length}}" class="recipient-switcher">
      <scroll-view class="recipient-scroll" scroll-x="{{!sortingId}}" scroll-left="{{railLeft}}" scroll-into-view="{{sortingId ? '' : activeTabId}}" scroll-with-animation="{{!sortingId}}" enable-flex="true" bindscroll="railScroll"><view class="recipient-tabs"><button wx:for="{{recipients}}" wx:key="id" id="recipient-{{item.id}}" class="recipient-tab {{active.id === item.id ? 'active' : ''}} {{sortingId === item.id ? 'sorting' : ''}} {{targetId === item.id &amp;&amp; sortingId !== item.id ? 'target' : ''}}" data-id="{{item.id}}" bindtap="select" bindlongpress="longPress" bindtouchmove="dragMove" bindtouchend="dragEnd">{{item.display_name}}</button></view></scroll-view>
      <button class="recipient-add" bindtap="create" aria-label="添加 TA">＋</button>
    </view>
  </view>
  <view wx:if="{{error}}" class="book-error" role="alert">{{error}}<button bindtap="load">重试</button></view>
  <view wx:if="{{loading}}" class="book-empty">正在打开礼物簿…</view>
  <block wx:elif="{{!error}}">
    <view wx:if="{{!recipients.length}}" class="book-empty"><view class="empty-title">还没有人</view><button class="empty-action" bindtap="create">添加第一个人</button></view>
    <block wx:else>
      <view class="content">
        <view class="recipient-summary"><view><view class="summary-name">{{active.display_name}}</view><view class="summary-meta">{{active.relation_type}}{{active.age_range ? ' · ' + active.age_range + ' 岁' : ''}}</view></view><button class="circle-action" bindtap="personActions" aria-label="管理这位 TA">•••</button></view>
        <view wx:if="{{active.tags.length}}" class="tag-line"><text wx:for="{{active.tags}}" wx:key="*this">{{index ? ' · ' : ''}}{{item}}</text></view>
        <view wx:if="{{sortingId}}" class="sort-hint">拖到另一位 TA 的位置调整顺序</view>
        <view class="gift-log">
          <view wx:if="{{loadingLog &amp;&amp; !gifts.length}}" class="log-empty">正在读取记录…</view>
          <view wx:if="{{logError}}" class="book-error">{{logError}}<button bindtap="load">重试</button></view>
          <view wx:if="{{!loadingLog &amp;&amp; !gifts.length &amp;&amp; !logError}}" class="log-empty"><view>还没有礼物记录</view><button bindtap="add">记第一份</button></view>
          <view wx:for="{{gifts}}" wx:key="id" class="log-shell" data-id="{{item.id}}" bindtouchstart="swipeStart" bindtouchmove="swipeMove" bindtouchend="swipeEnd"><view class="swipe-actions"><button data-id="{{item.id}}" bindtap="editGift">编辑</button><button class="danger-action" data-id="{{item.id}}" bindtap="deleteGift">删除</button></view><view class="log-entry {{swipeId === item.id ? 'swiped' : ''}}" data-id="{{item.id}}" bindtap="openGift" bindlongpress="giftActions"><view class="log-date"><text class="day">{{item.log_date}}</text><text wx:if="{{item.log_year}}" class="year">{{item.log_year}}</text></view><view class="log-title">{{item.gift_name}}</view><view wx:if="{{item.log_meta}}" class="log-meta">{{item.log_meta}}</view><view class="log-reaction">{{item.log_reaction}}</view><view wx:if="{{item.note}}" class="log-note">{{item.note}}</view></view></view>
          <button wx:if="{{cursor}}" class="load-more" bindtap="more" disabled="{{loadingLog}}">更早的记录</button>
        </view>
      </view>
      <button class="gift-fab" bindtap="add" aria-label="记一份礼物">＋</button>
    </block>
  </block>
  <view wx:if="{{sheet}}" class="sheet-layer"><view class="sheet-backdrop" bindtap="closeSheet"></view><view class="sheet {{sheetFull ? 'full' : ''}}" style="padding-top:{{sheetFull ? statusTop : 0}}px"><button class="sheet-handle" bindtap="expandSheet" aria-label="展开或收起表单"><view></view></button><view class="sheet-heading"><view><text wx:if="{{sheet === 'gift'}}" class="sheet-kicker">给 {{active.display_name}}</text><view class="sheet-title">{{sheetEditId ? (sheet === 'gift' ? '编辑礼物' : '编辑 TA') : (sheet === 'gift' ? '记一份礼物' : '添加一个人')}}</view></view><button class="sheet-close" bindtap="closeSheet" aria-label="关闭">×</button></view><scroll-view scroll-y class="sheet-fields"><block wx:if="{{sheet === 'gift'}}"><view class="sheet-field"><text class="field-label">礼物</text><input placeholder="送了什么？" value="{{giftForm.gift_name}}" data-form="giftForm" data-field="gift_name" bindinput="sheetInput" maxlength="60"/></view><view class="field-label reaction-label">TA 的反应</view><scroll-view scroll-x class="reaction-scroll"><view class="reaction-options"><button wx:for="{{reactions}}" wx:key="value" class="reaction-option {{giftForm.reaction_level === item.value ? 'selected' : ''}}" data-value="{{item.value}}" bindtap="sheetReaction">{{item.label}}</button></view></scroll-view><picker class="sheet-row" mode="date" end="{{today}}" value="{{giftForm.gifted_at}}" data-form="giftForm" data-field="gifted_at" bindchange="sheetInput"><text>日期</text><text>{{giftForm.gifted_at}} ›</text></picker><button class="sheet-row expand-row" bindtap="expandFields"><text>再记一点</text><text>{{sheetExpanded ? '收起' : '›'}}</text></button><view wx:if="{{sheetExpanded}}"><picker class="sheet-row" range="{{occasions}}" data-form="giftForm" data-field="occasion" data-options="occasions" bindchange="sheetPick"><text>场景</text><text>{{giftForm.occasion || '选填'}} ›</text></picker><view class="sheet-field"><text class="field-label">价格 · 元</text><input type="digit" placeholder="选填" value="{{giftPrice}}" bindinput="sheetPrice" maxlength="12"/></view><view class="sheet-field"><text class="field-label">备注</text><textarea placeholder="TA 收到时说了什么？" value="{{giftForm.note}}" data-form="giftForm" data-field="note" bindinput="sheetInput" maxlength="300"/></view></view></block><block wx:else><view class="sheet-field"><text class="field-label">称呼</text><input placeholder="你怎么称呼 TA？" value="{{personForm.display_name}}" data-form="personForm" data-field="display_name" bindinput="sheetInput" maxlength="20"/></view><picker class="sheet-row" range="{{relations}}" data-form="personForm" data-field="relation_type" data-options="relations" bindchange="sheetPick"><text>关系</text><text>{{personForm.relation_type || '请选择'}} ›</text></picker><button class="sheet-row expand-row" bindtap="expandFields"><text>再多记一点</text><text>{{sheetExpanded ? '收起' : '›'}}</text></button><view wx:if="{{sheetExpanded}}"><picker class="sheet-row" range="{{ages}}" data-form="personForm" data-field="age_range" data-options="ages" bindchange="sheetPick"><text>年龄段</text><text>{{personForm.age_range || "选填"}} ›</text></picker><picker class="sheet-row" range="{{genders}}" data-form="personForm" data-field="gender" data-options="genders" bindchange="sheetPick"><text>性别</text><text>{{personForm.gender || "选填"}} ›</text></picker><view class="sheet-field"><text class="field-label">TA 的喜好 · 最多 8 个</text><view class="tag-options"><button wx:for="{{tagChoices}}" wx:key="label" class="tag-choice {{item.selected ? "selected" : ""}}" data-tag="{{item.label}}" bindtap="sheetTag">{{item.label}}</button></view></view><view class="sheet-field"><text class="field-label">备注</text><textarea placeholder="关于 TA，想记住的事" value="{{personForm.note}}" data-form="personForm" data-field="note" bindinput="sheetInput" maxlength="200"/></view></view></block><view wx:if="{{sheetError}}" class="sheet-error" role="alert">{{sheetError}}</view></scroll-view><button class="sheet-save" bindtap="saveSheet" loading="{{sheetBusy}}" disabled="{{sheetBusy}}">{{sheetEditId ? '保存修改' : (sheet === 'gift' ? '记下来' : '加入礼物簿')}}</button></view></view>
</view>

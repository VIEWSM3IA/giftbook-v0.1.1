<view class="page account-page"><view class="title">账号与设置</view>
<view wx:if="{{error}}" class="error" role="alert">{{error}}</view><button wx:if="{{error}}" class="secondary" bindtap="load">重新加载</button>
<view class="account-profile"><view class="account-photo">{{user.display_name ? user.display_name[0] : '我'}}</view><view class="person-copy"><view class="name">{{user.display_name || "礼物簿账号"}}</view></view><button wx:if="{{!editing}}" class="link" bindtap="editName" disabled="{{busy || !user}}">个人设置</button></view>
<view wx:if="{{editing}}"><view class="row"><view class="label">昵称 · 1–20 个字</view><input value="{{nickname}}" bindinput="inputName" maxlength="20" focus="{{editing}}" disabled="{{busy}}" placeholder="怎么称呼你？" aria-label="昵称"/></view><view wx:if="{{nameError}}" class="error" role="alert">{{nameError}}</view><view class="name-actions"><button class="secondary" bindtap="cancelName" disabled="{{busy}}">取消</button><button class="primary" bindtap="saveName" loading="{{busy}}" disabled="{{busy}}">保存昵称</button></view></view>
<view class="account-rows"><button bindtap="privacy">隐私与数据</button><button bindtap="about">关于礼物簿</button><button bindtap="logout" disabled="{{busy}}">退出登录</button></view>
<button class="account-delete" bindtap="remove" disabled="{{busy}}">注销账号</button></view>
page{background:#F7F7F9;color:#111114}.account-page{padding-top:26rpx}.account-page .title{font-size:48rpx}.account-profile{display:flex;align-items:center;gap:22rpx;padding:28rpx 0;border-bottom:1rpx solid rgba(60,60,67,.12)}.account-photo{width:96rpx;height:96rpx;border-radius:50%;background:#E3E3E8;color:#111114;display:flex;align-items:center;justify-content:center;font-size:34rpx}.account-profile .person-copy{flex:1}.account-profile .link{font-size:26rpx}.account-rows{margin-top:34rpx}.account-rows button{width:100%;text-align:left;background:transparent;border-radius:0;border-bottom:1rpx solid rgba(60,60,67,.12);font-size:30rpx;padding:0;min-height:110rpx;line-height:110rpx}.account-delete{color:#D70015;background:transparent;padding:0;margin-top:48rpx;font-size:26rpx;min-height:88rpx}.name-actions{display:flex;gap:16rpx;padding:16rpx 0}.name-actions button{flex:1;margin:0}

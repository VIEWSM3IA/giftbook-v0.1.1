<view class="case-page"><view class="case-title">看看</view><view class="case-sub">匿名礼物案例，演示数据会标明</view><button class="case-secondary" bindtap="mine">我的分享 ›</button><scroll-view scroll-x class="case-filters"><view class="case-filter-inner"><picker wx:for="{{filters}}" wx:key="field" range="{{item.options}}" data-field="{{item.field}}" bindchange="filter"><button class="{{item.active &amp;&amp; item.active !== item.label ? 'selected' : ''}}">{{item.active || item.label}} ▾</button></picker></view></scroll-view><view wx:if="{{error}}" class="case-error">{{error}}<button bindtap="load">重试</button></view><view wx:if="{{!loading &amp;&amp; !items.length}}" class="case-empty">还没有符合条件的案例。可以换个条件看看。</view><view wx:for="{{items}}" wx:key="id" class="case-card"><view data-id="{{item.id}}" bindtap="open"><view class="case-card-title">{{item.gift_name}}</view><view class="case-facts">{{item.source_type === 'internal_mock' ? '演示案例 · ' : ''}}{{item.relation_type}} · {{item.age_range}} 岁 · {{item.occasion}}</view><view class="case-facts">{{item.price_range}} 元 · {{item.wanted_level}}</view><view class="case-result">{{item.reaction}} · {{item.evidence_label}}</view><view wx:if="{{item.experience}}" class="case-experience">“{{item.experience}}”</view></view><view class="case-action-row"><button data-id="{{item.id}}" bindtap="helpful" class="{{item.helped || item.is_mine ? 'active' : ''}}" disabled="{{item.helped || item.is_mine}}">{{item.is_mine ? '我的分享' : item.helped ? '已觉得有帮助' : '有帮助'}} · {{item.helpful_count}}</button></view></view><button wx:if="{{nextOffset !== null}}" class="case-secondary" bindtap="more" disabled="{{loading}}">加载更多</button><view wx:if="{{loading}}" class="case-muted">正在读取…</view></view>

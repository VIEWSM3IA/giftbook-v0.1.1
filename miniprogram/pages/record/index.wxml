<view class="page">
  <view class="title">记一下</view>
  <view class="subtitle">这份礼物，送给了谁？</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <button wx:if="{{error}}" class="secondary" bindtap="load">重新加载</button>
  <view wx:if="{{loading}}" class="empty">正在打开通讯录…</view>
  <view wx:elif="{{!error}}" class="section">
    <view wx:if="{{!recipients.length}}" class="card">
      <view class="name">先记下收礼物的人</view>
      <view class="meta">有了 TA，就能开始记下每一份心意。</view>
    </view>
    <view wx:for="{{recipients}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="select">
      <view class="person-main"><view class="avatar tone-{{item.tone}}">{{item.initial}}<view class="bookmark"></view></view><view class="person-copy"><view class="name">{{item.display_name}}</view><view class="meta">{{item.relation_type}}</view></view><view class="chevron">›</view></view>
    </view>
    <button class="{{recipients.length ? 'secondary' : 'primary'}}" bindtap="create">新建 TA</button>
  </view>
</view>

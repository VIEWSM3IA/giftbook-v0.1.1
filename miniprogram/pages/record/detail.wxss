.detail-page{background:#F7F7F9}.detail-heading{padding:44rpx 0 34rpx}.detail-title{font-size:62rpx;font-weight:700;line-height:1.2}.detail-reaction{color:#C54868;font-size:28rpx;margin-top:14rpx}.detail-row{display:flex;align-items:center;justify-content:space-between;min-height:108rpx;border-bottom:1rpx solid rgba(60,60,67,.12);font-size:29rpx}.detail-row text:first-child{color:#6E6E73}.detail-note{font-size:29rpx;line-height:1.6;padding:42rpx 0;border-bottom:1rpx solid rgba(60,60,67,.12);white-space:pre-wrap}.detail-edit{position:fixed;right:32rpx;bottom:calc(32rpx + env(safe-area-inset-bottom));height:88rpx;line-height:88rpx;border-radius:44rpx;background:#C54868;color:#fff;padding:0 38rpx;font-size:28rpx}.detail-delete{margin-top:40rpx}

<view class="page"><view wx:if="{{error}}" class="error" role="alert">{{error}}</view><button wx:if="{{error}}" class="secondary" bindtap="load">重新加载</button><block wx:if="{{gift}}"><view class="subtitle">送给 {{person.display_name}}</view><view class="title">{{gift.gift_name}}</view><view class="section group"><view class="row"><view class="label">TA 的反应</view>{{gift.reaction}}</view><view class="row"><view class="label">送礼日期</view>{{gift.gifted_at}}</view><view wx:if="{{gift.occasion}}" class="row"><view class="label">场景</view>{{gift.occasion}}</view><view wx:if="{{gift.price}}" class="row"><view class="label">价格</view>¥{{gift.price}}</view><view wx:if="{{gift.note}}" class="row"><view class="label">备注</view><view class="note">{{gift.note}}</view></view></view><button class="primary" bindtap="edit">编辑记录</button><button class="link danger section" bindtap="remove" disabled="{{busy}}">删除记录</button></block></view>
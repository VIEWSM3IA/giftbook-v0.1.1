<view class="page detail-page"><view wx:if="{{error}}" class="error" role="alert">{{error}}</view><button wx:if="{{error}}" class="secondary" bindtap="load">重新加载</button><block wx:if="{{gift}}"><view class="detail-heading"><view class="detail-title">{{gift.gift_name}}</view><view class="detail-reaction">{{gift.reaction}}</view></view><view class="detail-row"><text>送给</text><text>{{person.display_name}}</text></view><view class="detail-row"><text>日期</text><text>{{gift.gifted_at}}</text></view><view wx:if="{{gift.occasion}}" class="detail-row"><text>场景</text><text>{{gift.occasion}}</text></view><view wx:if="{{gift.price}}" class="detail-row"><text>价格</text><text>¥{{gift.price}}</text></view><view wx:if="{{gift.note}}" class="detail-note">{{gift.note}}</view><button class="detail-edit" bindtap="edit">编辑</button><button class="link danger detail-delete" bindtap="remove" disabled="{{busy}}">删除记录</button></block></view>

<view class="page"><view class="title">{{id ? "编辑记录" : "记一份礼物"}}</view><view class="subtitle">送给 {{person.display_name || "TA"}}</view><view wx:if="{{error}}" class="error" role="alert">{{error}}</view><button wx:if="{{error &amp;&amp; !person}}" class="link" bindtap="load">重新加载</button><view class="section group"><view class="row"><view class="label">礼物名称</view><input placeholder="送了什么礼物" value="{{form.gift_name}}" data-field="gift_name" bindinput="input" maxlength="60"/></view><view class="row"><view class="label">TA 的反应</view><view class="chips"><view wx:for="{{reactions}}" wx:key="value" class="chip {{form.reaction_level === item.value ? 'selected' : ''}}" data-value="{{item.value}}" bindtap="selectReaction">{{item.label}}</view></view></view><picker class="row" mode="date" end="{{today}}" value="{{form.gifted_at}}" data-field="gifted_at" bindchange="input"><view class="label">送礼日期</view>{{form.gifted_at}}</picker></view><button class="link" bindtap="toggle">{{expanded ? "收起补充信息 −" : "再补充一点 ＋"}}</button><view wx:if="{{expanded}}" class="group"><picker class="row" range="{{occasions}}" bindchange="occasion"><view class="label">送礼场景 · 选填</view>{{form.occasion || "选择场景"}}</picker><view class="row"><view class="label">价格 · 选填</view><input type="digit" placeholder="¥ 0.00" value="{{price}}" bindinput="priceInput" maxlength="12"/></view><view class="row"><view class="label">备注 · 选填</view><textarea placeholder="那天的故事，或 TA 的一句话" value="{{form.note}}" data-field="note" bindinput="input" maxlength="300"/></view></view><button class="primary" bindtap="save" loading="{{busy}}" disabled="{{busy || loading || !person}}">保存记录</button></view>
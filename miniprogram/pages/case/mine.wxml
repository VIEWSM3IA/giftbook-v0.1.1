<view class="case-page"><view class="case-title">我的分享</view><view class="case-sub">管理你公开的匿名案例。下架不会删除礼物记录。</view><view wx:if="{{error}}" class="case-error">{{error}}<button bindtap="load">重试</button></view><view wx:if="{{loading}}" class="case-muted">正在读取…</view><view wx:if="{{!loading &amp;&amp; !items.length}}" class="case-empty">还没有分享。打开礼物记录就能匿名分享。</view><view wx:for="{{items}}" wx:key="id" class="case-card"><view class="case-card-title">{{item.gift_name}}</view><view class="case-facts">{{item.relation_type}} · {{item.age_range}} 岁 · {{item.occasion}}</view><view class="case-status">{{item.status === 'published' ? '公开中' : '已下架'}} · 有帮助 {{item.helpful_count}}</view><view wx:if="{{item.status === 'published'}}" class="case-action-row"><button data-id="{{item.id}}" bindtap="open">查看</button><button data-id="{{item.id}}" bindtap="edit">编辑</button><button data-id="{{item.id}}" bindtap="remove">下架</button></view></view></view>

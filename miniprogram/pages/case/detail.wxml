<view class="case-page case-detail"><view wx:if="{{loading}}" class="case-muted">正在读取…</view><view wx:if="{{error}}" class="case-error" role="alert">{{error}}<button bindtap="load">重试</button></view><block wx:if="{{item}}"><view class="case-title">{{item.gift_name}}</view><view class="case-sub">匿名真实送礼案例</view><view class="case-row"><text>关系</text><text>{{item.relation_type}}</text></view><view class="case-row"><text>年龄段</text><text>{{item.age_range}} 岁</text></view><view class="case-row"><text>场景</text><text>{{item.occasion}}</text></view><view class="case-row"><text>价格区间</text><text>{{item.price_range}} 元</text></view><view class="case-row"><text>对方之前想要吗</text><text>{{item.wanted_level}}</text></view><view class="case-row"><text>TA 的反应</text><text>{{item.reaction}}</text></view><view class="case-row"><text>行为证据</text><text>{{item.evidence_label}}</text></view><view wx:if="{{item.experience}}" class="case-row"><text>一句经验</text><text>{{item.experience}}</text></view><button class="case-primary" bindtap="helpful" disabled="{{item.helped || item.is_mine}}">{{item.is_mine ? '我的分享' : item.helped ? '已觉得有帮助' : '有帮助'}} · {{item.helpful_count}}</button></block></view>

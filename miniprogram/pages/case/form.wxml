<view class="case-page"><view class="case-title">{{caseId ? '编辑匿名分享' : '匿名分享这次经历'}}</view><view class="case-sub">来自你的“{{giftName}}”记录。不会公开 TA 的称呼或私人备注。</view><view wx:if="{{loading}}" class="case-muted">正在读取…</view><view wx:elif="{{unavailable}}" class="case-error" role="alert">{{error}}</view><block wx:else><picker class="case-row" range="{{relations}}" data-options="relations" data-field="relation_type" bindchange="pick"><text>关系</text><text>{{form.relation_type || '请选择'}} ›</text></picker><picker class="case-row" range="{{ages}}" data-options="ages" data-field="age_range" bindchange="pick"><text>年龄段</text><text>{{form.age_range || '请选择'}} ›</text></picker><picker class="case-row" range="{{occasions}}" data-options="occasions" data-field="occasion" bindchange="pick"><text>场景</text><text>{{form.occasion || '请选择'}} ›</text></picker><picker class="case-row" range="{{prices}}" data-options="prices" data-field="price_range" bindchange="pick"><text>价格区间</text><text>{{form.price_range || '请选择'}} ›</text></picker><picker class="case-row" range="{{wanted}}" data-options="wanted" data-field="wanted_level" bindchange="pick"><text>对方之前想要吗</text><text>{{form.wanted_level || '请选择'}} ›</text></picker><view class="case-label">TA 的实际反应</view><view class="case-reactions"><button wx:for="{{reactions}}" wx:key="value" class="{{form.reaction_level === item.value ? 'selected' : ''}}" data-value="{{item.value}}" bindtap="reaction">{{item.label}}</button></view><view class="case-label">行为证据 · 必填</view><input class="case-input" maxlength="80" placeholder="比如：当天就用了" value="{{form.behavior}}" data-field="behavior" bindinput="input"/><view class="case-label">一句经验 · 选填</view><textarea class="case-textarea" maxlength="120" placeholder="什么细节可能帮到别人？" value="{{form.experience}}" data-field="experience" bindinput="input"/><view class="case-preview"><view class="case-label">公开预览</view><view class="case-card-title">{{giftName}}</view><view class="case-facts">{{form.relation_type || '关系'}} · {{form.age_range || '年龄段'}} 岁 · {{form.occasion || '场景'}}</view><view class="case-facts">{{form.price_range || '价格区间'}} 元 · {{form.wanted_level || '想要程度'}}</view><view class="case-result">{{reactionLabel}} · {{form.behavior || '行为证据'}}</view><view wx:if="{{form.experience}}" class="case-experience">“{{form.experience}}”</view></view><view class="case-muted">发布前会检查联系方式、地址和私人称呼。公开后可在“我的分享”编辑或下架。</view><view wx:if="{{error}}" class="case-error" role="alert">{{error}}</view><button class="case-primary" bindtap="save" loading="{{busy}}" disabled="{{busy}}">{{caseId ? '保存修改' : '确认匿名分享'}}</button></block></view>

page{background:#F7F7F9;color:#111114}.login-native{min-height:100vh;display:flex;flex-direction:column;justify-content:space-between;padding:0 48rpx calc(56rpx + env(safe-area-inset-bottom))}.login-title{font-size:68rpx;font-weight:700;line-height:1.15;letter-spacing:-1rpx}.login-description{font-size:28rpx;color:#6E6E73;margin-top:20rpx}.login-primary{width:100%;min-height:100rpx;line-height:100rpx;border-radius:28rpx;background:#C54868;color:#fff;font-size:32rpx;font-weight:600}.privacy-link{display:block;min-width:176rpx;min-height:88rpx;line-height:88rpx;margin:20rpx auto 0;color:#6E6E73;background:transparent;font-size:24rpx}

<view class="page"><view wx:if="{{error}}" class="error" role="alert">{{error}}</view><button wx:if="{{error}}" class="secondary" bindtap="load">重新加载</button><block wx:if="{{person}}"><view class="section-head"><view class="title">{{person.display_name}}</view><button class="link" bindtap="edit">编辑</button></view><view class="subtitle">{{person.relation_type}} {{person.age_range}} {{person.gender}}</view><view wx:if="{{person.tags.length || person.note}}" class="section card"><view class="chips"><text class="chip" wx:for="{{person.tags}}" wx:key="*this">{{item}}</text></view><view wx:if="{{person.note}}" class="meta note">{{person.note}}</view></view><button class="primary" bindtap="add">记一份礼物</button><view class="section"><view class="section-head">送礼记录</view><view class="empty" wx:if="{{!gifts.length &amp;&amp; !loading}}">还没有记录。记下送过的第一份礼物吧。</view><view wx:for="{{gifts}}" wx:key="id" class="card {{item.id === highlight ? 'highlight' : ''}}" id="gift-{{item.id}}" data-id="{{item.id}}" bindtap="open"><view class="name">{{item.gift_name}}</view><view class="meta">{{item.gifted_at}} · {{item.reaction}}</view></view><button wx:if="{{cursor}}" class="secondary" bindtap="more" loading="{{loading}}" disabled="{{loading}}">更早的记录</button></view><button class="link danger section" bindtap="remove" disabled="{{busy}}">删除 TA</button></block></view>
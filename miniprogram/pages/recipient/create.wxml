<view class="page"><view class="title">{{id ? "编辑 TA" : "新建 TA"}}</view><view wx:if="{{error}}" class="error" role="alert">{{error}}</view><button wx:if="{{error &amp;&amp; id &amp;&amp; !ready}}" class="link" bindtap="load">重新加载资料</button><view class="section group"><view class="row"><view class="label">称呼</view><input placeholder="你平时怎么称呼 TA" value="{{form.display_name}}" data-field="display_name" bindinput="input" maxlength="20"/></view><picker class="row" range="{{relations}}" data-field="relation_type" data-options="relations" bindchange="pick"><view class="label">关系</view><view>{{form.relation_type || "选择你们的关系"}}</view></picker></view><button class="link" bindtap="toggle">{{expanded ? "收起补充信息 −" : "再补充一点 ＋"}}</button><view wx:if="{{expanded}}" class="group"><picker class="row" range="{{ages}}" data-field="age_range" data-options="ages" bindchange="pick"><view class="label">年龄段 · 选填</view>{{form.age_range || "选择年龄段"}}</picker><picker class="row" range="{{genders}}" data-field="gender" data-options="genders" bindchange="pick"><view class="label">性别 · 选填</view>{{form.gender || "选择性别"}}</picker><view class="row"><view class="label">喜好标签 · 最多 8 个</view><view class="chips"><view wx:for="{{tags}}" wx:key="label" class="chip {{item.selected ? 'selected' : ''}}" bindtap="tag" data-tag="{{item.label}}">{{item.label}}</view></view></view><view class="row"><view class="label">备注 · 选填</view><textarea placeholder="关于 TA，想记住的事" value="{{form.note}}" data-field="note" bindinput="input" maxlength="200"/></view></view><button class="primary" bindtap="save" loading="{{busy}}" disabled="{{busy || loading || !ready}}">保存</button><button wx:if="{{id}}" class="link danger section" bindtap="remove" disabled="{{busy}}">删除 TA</button></view>
@import "../../styles/sheet.wxss";
.case-share-sheet{height:78vh;max-height:78vh;min-height:78vh}.case-share-sheet.full{height:100vh;max-height:100vh;min-height:100vh}.case-section-label{margin:30rpx 0 10rpx}.case-choice-list{display:flex;gap:10rpx;overflow-x:auto;white-space:nowrap}.case-choice{flex:none;min-height:88rpx;line-height:72rpx;margin:0;padding:8rpx 22rpx;border-radius:44rpx;background:#ECECF0;color:#6E6E73;font-size:24rpx}.case-choice.selected{background:rgba(197,72,104,.12);color:#C54868;font-weight:600}.evidence-list{flex-wrap:wrap;white-space:normal}.case-preview{margin:32rpx 0 16rpx;padding:24rpx;border:1rpx solid rgba(60,60,67,.12);border-radius:24rpx;background:#fff;font-size:24rpx;color:#6E6E73;line-height:1.6}.case-preview-name{font-size:30rpx;font-weight:600;color:#111114}.case-preview-result{color:#C54868}.case-preview-private{margin-top:10rpx;font-size:22rpx}

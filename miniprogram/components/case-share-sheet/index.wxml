<view wx:if="{{visible}}" class="sheet-layer"><view class="sheet-backdrop" bindtap="close"></view><view class="sheet case-share-sheet {{full ? 'full' : ''}}" style="padding-top:{{full ? statusTop : 0}}px"><button class="sheet-handle" bindtap="toggleFull" bindtouchstart="handleTouchStart" bindtouchend="handleTouchEnd" disabled="{{busy}}" aria-label="展开或收起分享表单"><view></view></button><view class="sheet-heading"><view class="sheet-title">{{editId ? '编辑匿名分享' : '匿名分享这次经历'}}</view><button class="sheet-close" bindtap="close" aria-label="关闭">×</button></view><scroll-view scroll-y class="sheet-fields"><view class="sheet-field"><text class="field-label">公开礼物名称</text><input disabled="{{busy}}" maxlength="60" value="{{form.gift_name}}" data-field="gift_name" bindinput="input" placeholder="公开后显示的礼物名称"/></view><picker disabled="{{busy}}" class="sheet-row" range="{{relations}}" data-options="relations" data-field="relation_type" bindchange="pick"><text>关系</text><text>{{form.relation_type || '请选择'}} ›</text></picker><picker disabled="{{busy}}" class="sheet-row" range="{{ages}}" data-options="ages" data-field="age_range" bindchange="pick"><text>年龄段</text><text>{{form.age_range || '请选择'}} ›</text></picker><picker disabled="{{busy}}" class="sheet-row" range="{{occasions}}" data-options="occasions" data-field="occasion" bindchange="pick"><text>场景</text><text>{{form.occasion || '请选择'}} ›</text></picker><picker disabled="{{busy}}" class="sheet-row" range="{{prices}}" data-options="prices" data-field="price_range" bindchange="pick"><text>价格区间</text><text>{{form.price_range || '请确认'}} ›</text></picker><picker disabled="{{busy}}" class="sheet-row" range="{{wanted}}" data-options="wanted" data-field="wanted_level" bindchange="pick"><text>对方之前想要吗</text><text>{{form.wanted_level || '请选择'}} ›</text></picker><view class="field-label case-section-label">TA 的实际反应</view><view class="case-choice-list"><button disabled="{{busy}}" wx:for="{{reactions}}" wx:key="value" class="case-choice {{form.reaction_level === item.value ? 'selected' : ''}}" data-value="{{item.value}}" bindtap="reaction">{{item.label}}</button></view><view class="field-label case-section-label">实际发生了什么？· 至少选择一项</view><view class="case-choice-list evidence-list"><button disabled="{{busy}}" wx:for="{{evidenceChoices}}" wx:key="code" class="case-choice {{item.selected ? 'selected' : ''}}" data-code="{{item.code}}" bindtap="evidence">{{item.selected ? '✓ ' : ''}}{{item.label}}</button></view><view class="sheet-field"><text class="field-label">一句经验 · 选填</text><textarea disabled="{{busy}}" maxlength="120" value="{{form.experience}}" data-field="experience" bindinput="input" placeholder="什么细节可能帮到别人？"/></view><view class="case-preview"><view class="field-label">公开预览</view><view class="case-preview-name">{{form.gift_name || '公开礼物名称'}}</view><view>{{form.relation_type || '关系'}} · {{form.age_range || '年龄段'}} 岁 · {{form.occasion || '场景'}}</view><view>{{form.price_range || '价格区间'}} 元 · {{form.wanted_level || '想要程度'}}</view><view class="case-preview-result">{{reactionLabel}} · {{evidenceLabel || '实际行为'}}</view><view wx:if="{{form.experience}}">“{{form.experience}}”</view><view class="case-preview-private">不会公开 TA 称呼、私人备注或精确价格。</view></view><view wx:if="{{error}}" class="sheet-error" role="alert">{{error}}</view></scroll-view><button class="sheet-save" bindtap="save" loading="{{busy}}" disabled="{{busy}}">{{editId ? '保存修改' : '确认匿名分享'}}</button></view></view>

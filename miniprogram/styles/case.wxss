page{background:#F7F7F9;color:#111114}.case-page{padding:34rpx 40rpx calc(100rpx + env(safe-area-inset-bottom))}.case-title{font-size:46rpx;font-weight:700;margin:8rpx 0 14rpx}.case-sub,.case-muted{font-size:25rpx;color:#6E6E73;line-height:1.6}.case-error{color:#D70015;font-size:25rpx;margin:18rpx 0}.case-row{display:flex;align-items:center;justify-content:space-between;min-height:100rpx;border-bottom:1rpx solid rgba(60,60,67,.12);font-size:28rpx}.case-row text:last-child{color:#6E6E73}.case-label{font-size:24rpx;color:#6E6E73;margin:28rpx 0 12rpx}.case-reactions,.case-filters{display:flex;gap:10rpx;overflow-x:auto;white-space:nowrap}.case-reactions button,.case-filters button{flex:none;margin:0;padding:0 22rpx;border-radius:40rpx;background:#ECECF0;color:#6E6E73;font-size:24rpx;line-height:76rpx}.case-reactions .selected,.case-filters .selected{background:rgba(197,72,104,.12);color:#C54868}.case-input,.case-textarea{width:100%;background:#fff;border:1rpx solid rgba(60,60,67,.12);border-radius:16rpx;padding:20rpx;font-size:28rpx;box-sizing:border-box}.case-textarea{height:150rpx}.case-primary{width:100%;background:#C54868;color:#fff;border-radius:18rpx;font-size:29rpx;margin-top:40rpx;line-height:92rpx}.case-secondary{background:transparent;color:#C54868;font-size:27rpx;margin-top:22rpx}.case-card{display:block;text-align:left;border-bottom:1rpx solid rgba(60,60,67,.12);padding:28rpx 0}.case-card-title{font-size:32rpx;font-weight:600}.case-facts,.case-result,.case-experience{font-size:25rpx;line-height:1.55;margin-top:8rpx}.case-facts{color:#6E6E73}.case-result{color:#C54868}.case-experience{color:#343438}.case-action-row{display:flex;gap:18rpx;align-items:center;margin-top:20rpx}.case-action-row button{margin:0;font-size:25rpx;padding:0 24rpx;line-height:68rpx;border-radius:36rpx;border:1rpx solid rgba(60,60,67,.12);background:#fff}.case-action-row .active{color:#C54868}.case-empty{color:#6E6E73;font-size:27rpx;margin-top:60rpx}.case-link{color:#C54868;font-size:27rpx}.case-detail{padding-top:35rpx}.case-detail .case-row{align-items:flex-start;padding:26rpx 0}.case-detail .case-row text:last-child{max-width:65%;text-align:right}.case-status{font-size:24rpx;color:#6E6E73;margin-top:8rpx}
.case-filter-inner{display:flex;gap:10rpx;width:max-content}
.case-preview{background:#fff;border:1rpx solid rgba(60,60,67,.12);border-radius:18rpx;margin:36rpx 0 18rpx;padding:4rpx 22rpx 24rpx}

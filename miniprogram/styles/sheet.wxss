.sheet-layer{position:fixed;inset:0;z-index:30}
.sheet-backdrop{position:absolute;inset:0;background:rgba(0,0,0,.18)}
.sheet{position:absolute;left:0;right:0;bottom:0;max-height:80vh;min-height:60vh;display:flex;flex-direction:column;padding:0 36rpx calc(28rpx + env(safe-area-inset-bottom));border-radius:42rpx 42rpx 0 0;background:#FCFCFD;box-shadow:0 -20rpx 80rpx rgba(0,0,0,.14)}
.sheet.full{max-height:100vh;min-height:100vh;border-radius:0;padding-top:env(safe-area-inset-top)}
.sheet-handle{height:88rpx;min-height:88rpx;width:100%;padding:14rpx 0;background:transparent}
.sheet-handle view{width:72rpx;height:10rpx;margin:auto;border-radius:10rpx;background:#D1D1D6}
.sheet-heading{display:flex;align-items:flex-start;justify-content:space-between;padding:12rpx 0 24rpx}
.sheet-kicker{font-size:24rpx;color:#6E6E73}
.sheet-title{font-size:46rpx;font-weight:650;line-height:1.3}
.sheet-close{width:88rpx;height:88rpx;line-height:70rpx;padding:0;border-radius:50%;background:rgba(118,118,128,.12);color:#6E6E73;font-size:42rpx}
.sheet-fields{flex:1;min-height:0}
.sheet-field{padding:20rpx 0;border-bottom:1rpx solid rgba(60,60,67,.12)}
.field-label{display:block;color:#6E6E73;font-size:24rpx;margin-bottom:8rpx}
.sheet-field input{height:72rpx;font-size:34rpx}
.sheet-field textarea{min-height:120rpx;font-size:30rpx}
.sheet-row{display:flex;align-items:center;justify-content:space-between;min-height:96rpx;border-bottom:1rpx solid rgba(60,60,67,.12);font-size:29rpx;color:#111114}
.sheet-row text:last-child{color:#6E6E73}
.expand-row{width:100%;padding:0;background:transparent;border-radius:0;text-align:left}
.sheet-error{color:#D70015;font-size:26rpx;padding:20rpx 0}
.sheet-save{flex:none;width:100%;height:96rpx;line-height:96rpx;margin-top:24rpx;padding:0;border-radius:24rpx;background:#C54868;color:#fff;font-size:30rpx;font-weight:600}

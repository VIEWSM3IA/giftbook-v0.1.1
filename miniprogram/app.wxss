page{background:#F7F7F9;color:#111114;font-family:-apple-system,BlinkMacSystemFont,'PingFang SC',sans-serif;font-size:30rpx;line-height:1.5}view,text,button,input,textarea{box-sizing:border-box}button::after{border:0}button[disabled]{opacity:.5}.page{min-height:100vh;padding:28rpx 40rpx calc(80rpx + env(safe-area-inset-bottom))}.title{font-size:48rpx;font-weight:650;line-height:1.25;margin:16rpx 0 26rpx}.subtitle,.muted{color:#6E6E73;font-size:26rpx}.section{margin-top:32rpx}.section-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:16rpx;font-weight:600}.card,.group{background:transparent;border-radius:0;margin-bottom:16rpx}.card{padding:0}.row{padding:24rpx 0;border-bottom:1rpx solid rgba(60,60,67,.12);min-height:96rpx}.row:last-child{border-bottom:0}.label{font-size:24rpx;color:#6E6E73;margin-bottom:8rpx}.name{font-weight:600;font-size:34rpx}.meta{font-size:26rpx;color:#6E6E73;margin-top:8rpx}.empty{padding:48rpx 0;color:#6E6E73}.primary{background:#C54868;color:#fff;border-radius:24rpx;min-height:96rpx;font-size:30rpx;font-weight:600;line-height:96rpx;margin-top:28rpx}.secondary{background:rgba(197,72,104,.10);color:#C54868;border-radius:24rpx;min-height:88rpx;font-size:28rpx;margin-top:18rpx}.link{color:#C54868;background:transparent;padding:8rpx 0;font-size:28rpx;margin:0;line-height:1.6;min-height:88rpx}.danger{color:#D70015}.error{color:#D70015;font-size:26rpx;padding:18rpx 0;margin:14rpx 0}input{height:64rpx;width:100%;font-size:32rpx}textarea{width:100%;min-height:140rpx;font-size:30rpx}.chips{display:flex;gap:10rpx;flex-wrap:wrap}.chip{padding:16rpx 22rpx;min-height:88rpx;min-width:88rpx;display:flex;align-items:center;justify-content:center;border-radius:44rpx;background:rgba(118,118,128,.08);color:#6E6E73;font-size:26rpx}.selected{background:rgba(197,72,104,.10);color:#C54868}.highlight{outline:2rpx solid #C54868}.book{width:76rpx;height:94rpx;border-radius:10rpx 20rpx 20rpx 10rpx;background:#C54868;border-left:10rpx solid #9E3451;margin-bottom:56rpx}.login{padding-top:140rpx}.note{white-space:pre-wrap;word-break:break-all}.footer-note{font-size:24rpx;color:#6E6E73;line-height:1.8;margin-top:32rpx}.quiet-mark{text-align:center;color:#6E6E73;font-size:24rpx;margin-top:40rpx}

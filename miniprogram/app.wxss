page{background:#F7F7F9;color:#111114;font-family:-apple-system,BlinkMacSystemFont,'PingFang SC',sans-serif;font-size:30rpx;line-height:1.5}view,text,button,input,textarea{box-sizing:border-box}button::after{border:0}button[disabled]{opacity:.5}.page{min-height:100vh;padding:28rpx 40rpx calc(80rpx + env(safe-area-inset-bottom))}.title{font-size:48rpx;font-weight:650;line-height:1.25;margin:16rpx 0 26rpx}.row{padding:24rpx 0;border-bottom:1rpx solid rgba(60,60,67,.12);min-height:96rpx}.row:last-child{border-bottom:0}.label{font-size:24rpx;color:#6E6E73;margin-bottom:8rpx}.name{font-weight:600;font-size:34rpx}.primary{background:#C54868;color:#fff;border-radius:24rpx;min-height:96rpx;font-size:30rpx;font-weight:600;line-height:96rpx;margin-top:28rpx}.secondary{background:rgba(197,72,104,.10);color:#C54868;border-radius:24rpx;min-height:88rpx;font-size:28rpx;margin-top:18rpx}.link{color:#C54868;background:transparent;padding:8rpx 0;font-size:28rpx;margin:0;line-height:1.6;min-height:88rpx}.danger{color:#D70015}.error{color:#D70015;font-size:26rpx;padding:18rpx 0;margin:14rpx 0}input{height:64rpx;width:100%;font-size:32rpx}textarea{width:100%;min-height:140rpx;font-size:30rpx}

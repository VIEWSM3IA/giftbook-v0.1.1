page{background:#F7F4EF;color:#272320;font-family:-apple-system,BlinkMacSystemFont,'PingFang SC',sans-serif;font-size:32rpx;line-height:1.5}view,text,button,input,textarea{box-sizing:border-box}.page{padding:40rpx 48rpx 80rpx}.title{font-size:64rpx;font-weight:700;letter-spacing:-2rpx;line-height:1.2;margin:16rpx 0 24rpx}.subtitle,.muted{color:#777069;font-size:26rpx}.section{margin-top:48rpx}.section-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:20rpx;font-weight:600}.card,.group{background:#fff;border-radius:32rpx;overflow:hidden;margin-bottom:20rpx}.card{padding:32rpx}.row{padding:28rpx 32rpx;border-bottom:1rpx solid #E5DED7}.row:last-child{border:0}.label{font-size:26rpx;color:#777069;margin-bottom:16rpx}.name{font-weight:600;font-size:36rpx}.meta{font-size:26rpx;color:#777069;margin-top:10rpx}.empty{padding:64rpx 8rpx;color:#777069}.primary{background:#9D5757;color:#fff;border-radius:24rpx;min-height:104rpx;font-size:32rpx;font-weight:600;line-height:104rpx;margin-top:32rpx}.secondary{background:#fff;color:#9D5757;border-radius:24rpx;min-height:96rpx;font-size:30rpx;margin-top:20rpx}.link{color:#9D5757;background:transparent;padding:8rpx 0;font-size:28rpx;margin:0;line-height:1.6}.danger{color:#B54A45}.error{color:#B54A45;background:#FBEFF1;border-radius:20rpx;padding:24rpx;margin:24rpx 0;font-size:28rpx}button::after{border:0}button[disabled]{opacity:.5}input{height:56rpx;width:100%}textarea{width:100%;min-height:140rpx}.chips{display:flex;gap:12rpx;flex-wrap:wrap}.chip{padding:18rpx 24rpx;border:2rpx solid #E9E5E9;border-radius:18rpx;font-size:28rpx}.selected{background:#F0E1DF;border-color:#9D5757;color:#9D5757}.highlight{border:2rpx solid #9D5757}.book{width:76rpx;height:94rpx;border-radius:10rpx 20rpx 20rpx 10rpx;background:#9D5757;border-left:10rpx solid #78334A;margin-bottom:56rpx}.login{padding-top:160rpx}.note{white-space:pre-wrap;word-break:break-all}.stats{display:flex;gap:48rpx}.stat{font-size:48rpx;font-weight:600}.footer-note{font-size:24rpx;color:#777069;line-height:1.8;margin-top:40rpx}

.person-main{display:flex;align-items:center;gap:28rpx}.avatar{width:104rpx;height:112rpx;border-radius:34rpx;background:#F2E4E9;color:#96546C;display:flex;align-items:center;justify-content:center;font-size:44rpx;position:relative;flex-shrink:0}.bookmark{position:absolute;right:18rpx;top:0;width:10rpx;height:22rpx;background:currentColor;opacity:.35;clip-path:polygon(0 0,100% 0,100% 100%,50% 73%,0 100%)}.tone-1{background:#E7ECE7;color:#597362}.tone-2{background:#E9E8F2;color:#777096}.tone-3{background:#F3EADE;color:#977344}.person-copy{flex:1;min-width:0;word-break:break-all}.chevron{font-size:44rpx;color:#AAA2AC}.person-foot{display:flex;align-items:center;gap:16rpx;border-top:1rpx solid #E5DED7;margin-top:32rpx;padding-top:26rpx}.gift-summary{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#5F5863;font-size:26rpx}.reaction-label{font-size:24rpx;color:#9D5757;flex-shrink:0}.welcome-empty{text-align:center;padding:64rpx 40rpx}.welcome-empty .book{margin:24rpx auto 64rpx}.welcome-empty .meta{line-height:1.8;margin-top:24rpx}.quiet-mark{text-align:center;color:#827480;font-size:24rpx;margin-top:52rpx}
